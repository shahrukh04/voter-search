# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB Atlas ----
# Paste your Atlas connection string here (replace user/pass and cluster host)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jaliya?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (created by `npm run seed:users`) ----
ADMIN_USERNAME=shahrukh
ADMIN_PASSWORD=change-me-123
ADMIN_NAME=Shahrukh (Admin)

# ---- App ----
OWNER_NAME=Shahrukh
APP_TITLE=जालिया द्वितीय ग्राम पंचायत
CONTACT_MOBILE=6378375233


# ---- Twilio Verify (server-only credentials) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Alternatively authenticate with an API key SID (SK...) and secret:
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
