{
  "name": "jaliya",
  "version": "1.0.0",
  "private": true,
  "description": "जालिया मतदाता खोज — React + Node/Express + MongoDB Atlas",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "decode": "npm --prefix server run decode",
    "seed": "npm --prefix server run seed",
    "seed:users": "npm --prefix server run seed:users"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
